package-as: PetStatusAlert
move-folders:
  PetStatusAlert/PetStatusAlert_Config: PetStatusAlert_Config
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
ignore:
  - .agents
  - .github
  - AGENTS.md
  - CHANGELOG.md
  - CHANGELOG-qfx.txt
  - README.md
  - overview.md
  - tests
  - docs
  - tools
  - archive
  - releases
  - .workbuddy
  - *.zip
